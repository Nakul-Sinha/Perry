{
  "name": "perry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A code review tool in progress.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test --test-concurrency=4 \"apps/runner/test/*.test.ts\" \"apps/control/test/*.test.ts\"",
    "review:local": "node apps/runner/src/index.ts review",
    "ask:local": "node apps/runner/src/index.ts ask",
    "runner:pair": "node apps/runner/src/index.ts pair",
    "runner:status": "node apps/runner/src/index.ts pair-status",
    "runner:serve": "node apps/runner/src/index.ts serve",
    "review:fixture": "node tools/fixtures/review.ts",
    "check:model": "node tools/compatibility/model-live.ts",
    "check:baseline": "node tools/evaluation/static-baseline.ts",
    "dev:control": "pnpm --filter @perry/control dev",
    "dev:runner": "pnpm --filter @perry/runner dev"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
