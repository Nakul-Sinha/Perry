{
  "name": "perry",
  "version": "0.0.0",
  "private": true,
  "description": "A code review tool in progress.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "dev:control": "pnpm --filter @perry/control dev",
    "dev:runner": "pnpm --filter @perry/runner dev"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
